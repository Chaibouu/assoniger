NEXT_PUBLIC_APP_URL="http://localhost:3000"
DATABASE_URL=""
# Développement local uniquement : désactive la vérif Have I Been Pwned (mot de passe trop courant → 400)
# SKIP_HIBP_CHECK=true
# REDIS_URL=redis://localhost:6379
AES_SECRET_KEY=""   #node ./crypto.js
#OAUTH VARIABLES
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
#MAIL VARIABLES (SMTP)
EMAIL_SERVER_HOST=
# 465 = TLS direct, 587 = STARTTLS
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
# Expéditeur affiché, ex. AssoNiger <no-reply@domaine>
EMAIL_FROM=
# Générer une clé privée (2048 bits)
#openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048

# Extraire la clé publique
#openssl rsa -pubout -in private.pem -out public.pem
RSA_PRIVATE_KEY=""
RSA_PUBLIC_KEY=""
# IP client (rate limiting) — header posé par le proxy de confiance, ex. cf-connecting-ip (Cloudflare) ou x-real-ip (nginx)
# TRUSTED_IP_HEADER=
# Nombre de proxys de confiance qui ajoutent une entrée à X-Forwarded-For (défaut : 1)
# TRUSTED_PROXY_COUNT=1

# Super-admin initial créé par `npm run seed` (mot de passe : 12 caractères minimum)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super administrateur
# true : réinitialise le mot de passe du compte s il existe déjà
# SUPER_ADMIN_RESET_PASSWORD=false

# Cloudflare R2 (stockage des fichiers)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
